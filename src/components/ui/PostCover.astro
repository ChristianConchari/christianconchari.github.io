---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { topicIndex, TOPIC_ICON, ICON_PATHS, TOPIC_COVER_BG, TOPIC_ICON_COLOR } from '../../utils/topics';

interface Props {
  cover?: ImageMetadata;
  coverAlt?: string;
  tag?: string;
  size?: 'sm' | 'row' | 'md' | 'lg';
  class?: string;
}

const { cover, coverAlt, tag, size = 'md', class: className } = Astro.props;

const sizeClass = { sm: 'h-10 w-14', row: 'h-16 w-16', md: 'h-40 w-full', lg: 'h-52 w-full' }[size];
const iconSizeClass = { sm: 'w-5 h-5', row: 'w-6 h-6', md: 'w-11 h-11', lg: 'w-14 h-14' }[size];
const widths = { sm: 112, row: 128, md: 640, lg: 1024 }[size];

const idx = topicIndex(tag);
const coverClass = TOPIC_COVER_BG[idx];
const iconColorClass = TOPIC_ICON_COLOR[idx];
const iconPath = ICON_PATHS[TOPIC_ICON[idx]];
---

<div class:list={['post-cover relative shrink-0 overflow-hidden', sizeClass, className]}>
  {
    cover ? (
      <Image
        src={cover}
        alt={coverAlt ?? ''}
        width={cover.width}
        height={cover.height}
        widths={[widths / 2, widths]}
        sizes={size === 'sm' || size === 'row' ? `${widths}px` : `(min-width: 1024px) ${widths}px, 100vw`}
        loading={size === 'lg' ? 'eager' : 'lazy'}
        class="h-full w-full object-cover"
      />
    ) : (
      <div class:list={['absolute inset-0 flex items-center justify-center', coverClass]}>
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          class:list={[iconSizeClass, iconColorClass]}
          set:html={iconPath}
        />
      </div>
    )
  }
  <slot />
</div>
