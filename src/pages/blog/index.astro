---
import { getCollection } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';
import PostCover from '../../components/ui/PostCover.astro';
import Tag from '../../components/ui/Tag.astro';
import Icon from '../../components/Icon.astro';
import { topicIndex, TOPIC_TEXT, TOPIC_CHIP_BG } from '../../utils/topics';

const allEntries = await getCollection('blog');

// A post with an ES/EN translation pair shares one translationKey — show
// just one card for it (preferring Spanish, the primary audience). The
// post page itself offers a switcher to read the other language.
const byTranslationKey = new Map<string, (typeof allEntries)[number]>();
for (const entry of allEntries) {
  const key = entry.data.translationKey ?? entry.slug;
  const existing = byTranslationKey.get(key);
  if (!existing || (entry.data.lang === 'es' && existing.data.lang !== 'es')) {
    byTranslationKey.set(key, entry);
  }
}
const posts = [...byTranslationKey.values()];
posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const allTags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
}
---

<BlogLayout title="Blog" activeTab="all">
  <!-- Hero -->
  <section
    class="bg-background-light dark:bg-background-dark border-b border-gray-200 dark:border-navy-light px-6 md:px-12 pt-16 pb-12"
  >
    <h1 class="text-5xl font-bold font-mono text-text-light dark:text-text-dark mb-4">Blog</h1>
    <p class="text-lg text-muted-light dark:text-muted-dark max-w-xl leading-relaxed">
      Thoughts on software architecture, machine learning, and building things that last.
    </p>
  </section>

  {
    posts.length === 0 ? (
      <div class="max-w-5xl mx-auto px-6 md:px-12 py-24 text-center">
        <p class="text-2xl font-bold font-mono text-text-light dark:text-text-dark mb-3">
          No posts yet
        </p>
        <p class="text-muted-light dark:text-muted-dark">
          Check back soon — new writing is on the way.
        </p>
      </div>
    ) : (
      <div class="px-6 md:px-12 py-16 flex flex-col md:flex-row items-start gap-10 md:gap-16">
        {/* Sidebar */}
        <aside class="w-full md:w-56 md:shrink-0 flex flex-col gap-8">
          <p class="text-sm font-bold font-mono uppercase tracking-widest text-text-light dark:text-text-dark">
            Filter &amp; sort
          </p>

          <div>
            <label
              for="sort-select"
              class="block text-xs font-mono uppercase tracking-widest text-muted-light dark:text-muted-dark mb-2"
            >
              Sort by
            </label>
            <div class="relative">
              <select
                id="sort-select"
                class="w-full appearance-none rounded-lg border border-gray-200 dark:border-navy-light bg-white dark:bg-navy-light/40 px-3 py-2 pr-8 text-sm font-mono text-text-light dark:text-text-dark focus:outline-none focus:border-primary transition-colors duration-200"
              >
                <option value="newest">Newest</option>
                <option value="oldest">Oldest</option>
              </select>
              <Icon
                name="chevron-down"
                class="pointer-events-none absolute right-2.5 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-muted-light dark:text-muted-dark"
              />
            </div>
          </div>

          <div>
            <label
              for="topic-select"
              class="block text-xs font-mono uppercase tracking-widest text-muted-light dark:text-muted-dark mb-2"
            >
              Topic
            </label>
            <div class="relative">
              <select
                id="topic-select"
                class="w-full appearance-none rounded-lg border border-gray-200 dark:border-navy-light bg-white dark:bg-navy-light/40 px-3 py-2 pr-8 text-sm font-mono text-text-light dark:text-text-dark focus:outline-none focus:border-primary transition-colors duration-200"
              >
                <option value="all">All topics</option>
                {allTags.map((tag) => (
                  <option value={tag}>{tag}</option>
                ))}
              </select>
              <Icon
                name="chevron-down"
                class="pointer-events-none absolute right-2.5 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-muted-light dark:text-muted-dark"
              />
            </div>
          </div>

          <div>
            <p class="text-xs font-mono uppercase tracking-widest text-muted-light dark:text-muted-dark mb-2">
              Tags
            </p>
            <div class="flex flex-wrap gap-2">
              <button class="filter-pill" data-tag="all" data-active="true">
                All
              </button>
              {allTags.map((tag) => (
                <button class="filter-pill" data-tag={tag} data-active="false">
                  {tag}
                </button>
              ))}
            </div>
          </div>
        </aside>

        {/* Main content */}
        <div class="flex-1 min-w-0 w-full">
          {/* Search + view toggle */}
          <div class="flex items-center gap-4 mb-8">
            <div class="flex-1 flex items-center gap-2.5 rounded-full border border-gray-200 dark:border-navy-light bg-white dark:bg-navy-light/40 px-4 py-2.5">
              <Icon name="search" class="w-4 h-4 shrink-0 text-muted-light dark:text-muted-dark" />
              <input
                type="search"
                id="search-input"
                placeholder="Search posts…"
                class="w-full bg-transparent text-sm text-text-light dark:text-text-dark focus:outline-none placeholder:text-muted-light dark:placeholder:text-muted-dark"
              />
            </div>
            <div class="flex items-center rounded-full border border-gray-200 dark:border-navy-light overflow-hidden shrink-0">
              <button
                id="view-grid-btn"
                data-active="true"
                class="view-toggle-btn flex items-center gap-1.5 px-3.5 py-2.5 text-xs font-mono font-bold transition-colors duration-150"
                aria-label="Grid view"
              >
                <Icon name="grid" class="w-3.5 h-3.5" />
                <span class="hidden sm:inline">Grid</span>
              </button>
              <button
                id="view-list-btn"
                data-active="false"
                class="view-toggle-btn flex items-center gap-1.5 px-3.5 py-2.5 text-xs font-mono font-bold transition-colors duration-150"
                aria-label="List view"
              >
                <Icon name="list" class="w-3.5 h-3.5" />
                <span class="hidden sm:inline">List</span>
              </button>
            </div>
          </div>

          {/* Post grid */}
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="grid-view">
            {posts.map((post) => (
              <a
                href={`/blog/${post.slug}`}
                class="post-card group bg-white dark:bg-background-dark border border-gray-200 dark:border-navy-light rounded-md overflow-hidden flex flex-col hover:border-primary transition-colors duration-200 no-underline"
                data-tags={post.data.tags.join(',')}
                data-title={post.data.title.toLowerCase()}
                data-timestamp={post.data.pubDate.getTime()}
              >
                <PostCover
                  cover={post.data.cover}
                  coverAlt={post.data.coverAlt ?? post.data.title}
                  tag={post.data.tags[0]}
                  size="md"
                />

                <div class="p-6 flex flex-col gap-4 flex-1">
                  <div class="flex gap-2 flex-wrap">
                    {post.data.tags.slice(0, 2).map((tag, i) =>
                      i === 0 ? (
                        <span
                          class:list={[
                            'rounded px-2 py-1 font-mono text-xs font-bold',
                            TOPIC_CHIP_BG[topicIndex(tag)],
                            TOPIC_TEXT[topicIndex(tag)],
                          ]}
                        >
                          {tag}
                        </span>
                      ) : (
                        <Tag variant="neutral">{tag}</Tag>
                      )
                    )}
                  </div>
                  <h2 class="text-xl font-bold text-text-light dark:text-text-dark leading-snug group-hover:text-primary transition-colors duration-200 m-0">
                    {post.data.title}
                  </h2>
                  <p class="text-base text-muted-light dark:text-muted-dark leading-relaxed line-clamp-2 m-0">
                    {post.data.description}
                  </p>
                  <div class="flex items-center gap-2 text-base text-muted-light dark:text-muted-dark mt-auto font-mono pt-1">
                    <span>{formatDate(post.data.pubDate)}</span>
                    <span class:list={[TOPIC_TEXT[topicIndex(post.data.tags[0])]]}>▸</span>
                    <span>{post.data.readingTime} min</span>
                  </div>
                </div>
              </a>
            ))}
          </div>

          {/* Post list — a compact row per post, no description, for less vertical space */}
          <div class="hidden flex-col divide-y divide-gray-200 dark:divide-navy-light" id="list-view">
            {posts.map((post) => (
              <a
                href={`/blog/${post.slug}`}
                class="post-card group flex items-center gap-4 py-4 hover:bg-gray-50 dark:hover:bg-navy-light/20 transition-colors duration-150 no-underline"
                data-tags={post.data.tags.join(',')}
                data-title={post.data.title.toLowerCase()}
                data-timestamp={post.data.pubDate.getTime()}
              >
                <PostCover
                  cover={post.data.cover}
                  coverAlt={post.data.coverAlt ?? post.data.title}
                  tag={post.data.tags[0]}
                  size="row"
                  class="rounded-md"
                />

                <div class="min-w-0 flex-1 flex items-center justify-between gap-4">
                  <div class="min-w-0">
                    <span
                      class:list={[
                        'inline-block rounded px-2 py-0.5 font-mono text-[11px] font-bold mb-1',
                        TOPIC_CHIP_BG[topicIndex(post.data.tags[0])],
                        TOPIC_TEXT[topicIndex(post.data.tags[0])],
                      ]}
                    >
                      {post.data.tags[0]}
                    </span>
                    <h2 class="text-base font-bold text-text-light dark:text-text-dark leading-snug truncate group-hover:text-primary transition-colors duration-200 m-0">
                      {post.data.title}
                    </h2>
                  </div>
                  <div class="hidden sm:flex items-center gap-2 text-sm text-muted-light dark:text-muted-dark font-mono shrink-0">
                    <span>{formatDate(post.data.pubDate)}</span>
                    <span class:list={[TOPIC_TEXT[topicIndex(post.data.tags[0])]]}>▸</span>
                    <span>{post.data.readingTime} min</span>
                  </div>
                </div>
              </a>
            ))}
          </div>

          <div
            id="no-results"
            class="hidden text-center py-16 text-muted-light dark:text-muted-dark font-mono text-base"
          >
            No posts match your filter.
          </div>
        </div>
      </div>
    )
  }
</BlogLayout>

<style>
  .view-toggle-btn {
    color: var(--color-muted-light);
  }
  .dark .view-toggle-btn {
    color: var(--color-muted-dark);
  }
  .view-toggle-btn[data-active='true'] {
    background: var(--color-primary);
    color: var(--color-background-dark);
  }
</style>

<script>
  const tagBtns = document.querySelectorAll<HTMLButtonElement>('.filter-pill');
  const postCards = document.querySelectorAll<HTMLAnchorElement>('.post-card');
  const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
  const noResults = document.getElementById('no-results');
  const sortSelect = document.getElementById('sort-select') as HTMLSelectElement | null;
  const topicSelect = document.getElementById('topic-select') as HTMLSelectElement | null;
  const gridView = document.getElementById('grid-view');
  const listView = document.getElementById('list-view');
  const viewGridBtn = document.getElementById('view-grid-btn') as HTMLButtonElement | null;
  const viewListBtn = document.getElementById('view-list-btn') as HTMLButtonElement | null;

  // This is a fully static site (no server), so a deep link like
  // /blog?tag=Rust can only be applied client-side after load — the
  // shipped HTML is identical regardless of query string.
  const requestedTag = new URLSearchParams(window.location.search).get('tag');
  const matchingBtn =
    requestedTag &&
    document.querySelector<HTMLButtonElement>(`.filter-pill[data-tag="${CSS.escape(requestedTag)}"]`);

  let activeTag = 'all';
  let searchQuery = '';

  if (matchingBtn) {
    tagBtns.forEach((b) => (b.dataset.active = 'false'));
    matchingBtn.dataset.active = 'true';
    activeTag = requestedTag;
    if (topicSelect) topicSelect.value = requestedTag;
  }

  function filterPosts() {
    let visible = 0;
    postCards.forEach((card) => {
      const tags = card.dataset.tags?.split(',') ?? [];
      const title = card.dataset.title ?? '';
      const matchesTag = activeTag === 'all' || tags.includes(activeTag);
      const matchesSearch = !searchQuery || title.includes(searchQuery);
      const show = matchesTag && matchesSearch;
      (card as HTMLElement).style.display = show ? '' : 'none';
      if (show) visible++;
    });
    if (noResults) noResults.style.display = visible === 0 ? '' : 'none';
  }

  filterPosts();

  function setActiveTag(tag: string) {
    activeTag = tag;
    tagBtns.forEach((b) => (b.dataset.active = String(b.dataset.tag === tag)));
    if (topicSelect) topicSelect.value = tag;
    filterPosts();

    const url = new URL(window.location.href);
    if (activeTag === 'all') {
      url.searchParams.delete('tag');
    } else {
      url.searchParams.set('tag', activeTag);
    }
    window.history.pushState({}, '', url);
  }

  tagBtns.forEach((btn) => {
    btn.addEventListener('click', () => setActiveTag(btn.dataset.tag ?? 'all'));
  });

  topicSelect?.addEventListener('change', () => setActiveTag(topicSelect.value));

  searchInput?.addEventListener('input', (e) => {
    searchQuery = (e.target as HTMLInputElement).value.trim().toLowerCase();
    filterPosts();
  });

  // Reorders cards visually via CSS `order` (grid and list are both flex/grid
  // containers, so both respect it) instead of moving DOM nodes around.
  function applySort() {
    const direction = sortSelect?.value === 'oldest' ? 1 : -1;
    const cards = Array.from(postCards);
    cards.sort((a, b) => {
      const ta = Number(a.dataset.timestamp ?? 0);
      const tb = Number(b.dataset.timestamp ?? 0);
      return direction === -1 ? tb - ta : ta - tb;
    });
    cards.forEach((card, index) => {
      (card as HTMLElement).style.order = String(index);
    });
  }

  applySort();
  sortSelect?.addEventListener('change', applySort);

  function setView(view: 'grid' | 'list') {
    gridView?.classList.toggle('hidden', view !== 'grid');
    listView?.classList.toggle('hidden', view !== 'list');
    viewGridBtn?.setAttribute('data-active', String(view === 'grid'));
    viewListBtn?.setAttribute('data-active', String(view === 'list'));
  }

  viewGridBtn?.addEventListener('click', () => setView('grid'));
  viewListBtn?.addEventListener('click', () => setView('list'));
</script>
